FDG_HOST=127.0.0.1
FDG_PORT=49123
FDG_PLAYLISTS=3,13
FDG_DATA_DIR=data
# Seconds to collect late final scoreboard updates; 0 saves immediately.
FDG_SETTLE_SECONDS=0
# Local retention only; Sheets history stays intact.
FDG_RAW_DAYS=7
FDG_RAW_MAX_MB=250
FDG_LOCAL_MATCH_DAYS=30
# Deploy apps_script/Code.gs, then paste the /exec URL and Script Property token.
FDG_SHEETS_URL=
FDG_SHEETS_TOKEN=
